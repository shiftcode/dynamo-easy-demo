{
  "TableName": "dynamo-easy-demo-timeEntries",
  "AttributeDefinitions": [
    { "AttributeName": "monthEmail", "AttributeType": "S" },
    { "AttributeName": "startDate", "AttributeType": "S" },
    { "AttributeName": "clientProject", "AttributeType": "S" },
    { "AttributeName": "unixTsUserId", "AttributeType": "N" }
  ],
  "KeySchema": [
    { "AttributeName": "monthEmail", "KeyType": "HASH" },
    { "AttributeName": "startDate", "KeyType": "RANGE" }
  ],
  "GlobalSecondaryIndexes": [
    {
      "IndexName": "clientProject-unixTsUserId-index",
      "KeySchema": [
        { "AttributeName": "clientProject", "KeyType": "HASH" },
        { "AttributeName": "unixTsUserId", "KeyType": "RANGE" }
      ],
      "Projection": { "ProjectionType": "ALL" }
    }
  ],
  "BillingMode": "PAY_PER_REQUEST"
}
